{
  "name": "studentflow-backend",
  "version": "1.0.0",
  "description": "StudentFlow backend API using Node.js and Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/api.test.js",
    "test:api": "node --test test/api.test.js",
    "test:automation": "node --test ../aws/lambda/automation/test/automation.test.js",
    "test:all": "node --test test/api.test.js ../aws/lambda/automation/test/automation.test.js",
    "automation:local": "node scripts/runLocalAutomation.js",
    "package:lambda": "node ../aws/scripts/package-lambda.js",
    "package:api": "node ../aws/scripts/package-api-lambda.js",
    "validate:template": "node ../aws/scripts/validate-template.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "serverless-http": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
